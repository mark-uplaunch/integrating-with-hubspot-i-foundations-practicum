doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="css/style.css")
    body    
        h1 Custom Object Table
        a.add-link(href="/update-cobj") Add/Update this table
        table 
            thead
                tr 
                    th Name 
                    th Brand 
                    th Type 
            tbody 
                each vehicle in data               
                    tr 
                        td #{vehicle.properties.name}
                        td #{vehicle.properties.brand} 
                        td #{vehicle.properties.type}
